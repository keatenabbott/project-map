rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // settings/portal is publicly readable — it's only a boolean flag
    // used by unauthenticated visitors to determine if an admin exists.
    // Write still requires auth so only signed-in code can flip the flag.
    match /settings/portal {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other documents require a signed-in user.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
