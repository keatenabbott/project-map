rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /settings/portal {
      allow read: if true;
    }
    match /costCodeTemplates/{docId} {
      allow read: if true;
    }
  }
}
